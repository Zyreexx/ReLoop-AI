# ReLoop AI Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MEDIA_RESOLUTION=HIGH
MAX_IDENTIFY_IMAGES=5
DEMO_FALLBACK=false

# Database (optional for demo MVP, in-memory store by default)
DATABASE_URL=

# Transactional Email (Resend)
# If RESEND_API_KEY is unset or empty, email_service operates in sandbox/test mode
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
